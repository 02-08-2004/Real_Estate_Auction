rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow users to read and write their own data
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Properties are public to read, but only sellers or admins can write
    match /properties/{propertyId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && (resource.data.sellerId == request.auth.uid || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
      
      // Registered bidders nested collection
      match /registeredBidders/{bidderId} {
        allow read: if true;
        allow write: if request.auth != null;
      }
    }

    // Bids: anyone can read, only authenticated users can create
    match /bids/{bidId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if false; // Bids should be immutable
    }

    // Notifications
    match /notifications/{notifId} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.userId;
    }
  }
}
